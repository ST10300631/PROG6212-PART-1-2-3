@model IEnumerable<RaceDaySystem.Client.Models.DTOs.CreateEventDto>

@{
    ViewData["Title"] = "Race Events";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1 class="display-4 text-primary"> Up Coming Race Events</h1>
        <p class="lead">
            View all upcoming running, walking and cycling events.
        </p>
    </div>



    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance (km)</th>
                        <th>Event Type</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var eventItem in Model)
                    {
                        <tr>
                            <td>@eventItem.Name</td>
                            <td>@eventItem.Description</td>
                            <td>@eventItem.Date.ToShortDateString()</td>
                            <td>@eventItem.Location</td>
                            <td>@eventItem.Distance</td>
                            <td>@eventItem.EventType</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No events found in the database.
        </div>
    }
</div>

