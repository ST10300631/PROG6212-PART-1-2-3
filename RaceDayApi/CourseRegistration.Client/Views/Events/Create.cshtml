@model RaceDaySystem.Client.Models.DTOs.CreateEventDto

@{
    ViewData["Title"] = "Create RaceDay Event";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow-sm border-0 p-4" style="border-radius: 8px;">

        <!-- Page Header Header -->
        <div class="mb-4 border-bottom pb-2">
            <h2 class="fw-bold text-dark mb-1">Create Race Event</h2>
            <p class="text-muted small">Fill out the fields below to add a new event to the system panel.</p>
        </div>

        <form asp-action="Create" method="post">

            <!-- Event Name -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold text-dark small">Event Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g., Annual Cycling Classic" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold text-dark small">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter registration terms and information..." required></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <!-- Date -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Date" class="form-label fw-bold text-dark small">Event Date</label>
                    <input asp-for="Date" type="date" class="form-control" required />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>

                <!-- Event Type -->
                <div class="col-md-6 mb-3">
                    <label asp-for="EventType" class="form-label fw-bold text-dark small">Event Type</label>
                    <input asp-for="EventType" class="form-control" placeholder="e.g., Marathon, Criterium" required />
                    <span asp-validation-for="EventType" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <!-- Location -->
                <div class="col-md-8 mb-3">
                    <label asp-for="Location" class="form-label fw-bold text-dark small">Location Venue</label>
                    <input asp-for="Location" class="form-control" placeholder="e.g., Kings Park Stadium" required />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <!-- Distance -->
                <div class="col-md-4 mb-4">
                    <label asp-for="Distance" class="form-label fw-bold text-dark small">Distance</label>
                    <div class="input-group">
                        <input asp-for="Distance" type="number" step="0.1" class="form-control" placeholder="0.0" required />
                        <span class="input-group-text bg-light text-muted small">km</span>
                    </div>
                    <span asp-validation-for="Distance" class="text-danger small"></span>
                </div>
            </div>

            <!-- Form Actions Footer Elements -->
            <div class="d-flex gap-2 justify-content-end border-top pt-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold btn-sm">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary px-4 fw-bold btn-sm">
                    Save Event
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
