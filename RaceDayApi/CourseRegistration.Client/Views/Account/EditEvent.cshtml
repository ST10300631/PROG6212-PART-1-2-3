@model RaceDaySystem.Client.Models.DTOs.CreateEventDto

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="text-primary mb-3">Edit Event</h2>
    <hr />

    <form asp-action="EditEvent" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Event Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Date" class="form-label">Date</label>
            <input asp-for="Date" type="date" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label">Location</label>
            <input asp-for="Location" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Distance" class="form-label">Distance (KM)</label>
            <input asp-for="Distance" type="number" step="0.1" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EventType" class="form-label">Event Type</label>
            <input asp-for="EventType" class="form-control" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Save Changes</button>
            <a asp-action="Organiser" asp-controller="Account" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

