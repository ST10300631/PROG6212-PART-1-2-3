@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">

    <h2 class="text-primary">Organiser Dashboard</h2>

    <ul class="nav nav-tabs">
        <li class="nav-item">
            <a class="nav-link active"
               data-bs-toggle="tab"
               href="#events">
                Event Management
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link"
               data-bs-toggle="tab"
               href="#categories">
                Category Management
            </a>
        </li>
    </ul>

    <div class="tab-content border p-4">

        <!-- EVENT CRUD -->
        <div class="tab-pane fade show active" id="events">

            <h3>Create Event</h3>

            <form asp-action="CreateEvent" method="post">

                <div class="mb-3">
                    <label>Event Name</label>
                    <input name="Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Description</label>
                    <textarea name="Description"
                              class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <label>Date</label>
                    <input type="date"
                           name="Date"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Location</label>
                    <input name="Location"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Distance (KM)</label>
                    <input type="number"
                           step="0.1"
                           name="Distance"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Event Type</label>
                    <input name="EventType"
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Create Event
                </button>
            </form>

            <hr />

            <h3>Event List</h3>

            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (ViewBag.Events != null)
                    {
                        foreach (var item in ViewBag.Events)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Date</td>
                                <td>@item.Location</td>
                                <td>@item.Distance</td>
                                <td>@item.EventType</td>

                                <td>
                                    <a asp-action="EditEvent"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="DeleteEvent"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>

        <!-- CATEGORY CRUD -->
        <div class="tab-pane fade" id="categories">

            <h3>Create Category</h3>

            <form asp-action="CreateCategory" method="post">

                <div class="mb-3">
                    <label>Name</label>

                    <input name="Name"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Description</label>

                    <textarea name="Description"
                              class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <label>Entry Fee</label>

                    <input type="number"
                           step="0.01"
                           name="EntryFee"
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Create Category
                </button>

            </form>

            <hr />

            <h3>Category List</h3>

            <table class="table table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Entry Fee</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (ViewBag.Categories != null)
                    {
                        foreach (var category in ViewBag.Categories)
                        {
                            <tr>

                                <td>@category.Name</td>
                                <td>@category.Description</td>
                                <td>R @category.EntryFee</td>

                                <td>

                                    <a asp-action="EditCategory"
                                       asp-route-id="@category.Id"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="DeleteCategory"
                                       asp-route-id="@category.Id"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>