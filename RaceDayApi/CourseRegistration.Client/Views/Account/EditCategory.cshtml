@model RaceDaySystem.Client.Models.DTOs.CategoryDto

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="text-primary mb-3">Edit Category</h2>
    <hr />

    <form asp-action="EditCategory" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Category Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="EntryFee" class="form-label">Entry Fee (R)</label>
            <input asp-for="EntryFee" type="number" step="0.01" class="form-control" required />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Organiser" asp-controller="Account" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
