@{
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex flex-column justify-content-center align-items-center min-vh-100 bg-light text-center px-3">
    <div class="card shadow-sm border-0 p-5" style="max-width: 500px; border-radius: 8px;">
        <div class="text-danger mb-4">
            <!-- Large warning shield icon -->
            <i class="bi bi-shield-lock-fill" style="font-size: 4rem;"></i>
        </div>

        <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
        <p class="text-muted mb-4">
            You do not have the necessary administrator permissions to view or modify this resource.
        </p>

        <div class="d-flex gap-2 justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-bold px-4">
                Go to Home
            </a>
            <button onclick="history.back()" class="btn btn-outline-secondary fw-bold px-4">
                Go Back
            </button>
        </div>
    </div>
</div>

