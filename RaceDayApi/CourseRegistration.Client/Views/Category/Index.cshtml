@model IEnumerable<RaceDaySystem.Client.Models.DTOs.CategoryDto>

@{
    ViewData["Title"] = "Race Categories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Available Race Categories</h2>
        <a class="btn btn-success" asp-action="Create">Create New Category</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-primary">
                    <tr>
                        <th scope="col" class="ps-4">Category Name</th>
                        <th scope="col">Description</th>
                        <th scope="col" class="text-end pe-4">Entry Fee</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                No race categories found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold ps-4">@item.Name</td>
                                <td class="text-muted">@item.Description</td>
                                <td class="text-end fw-bold text-success pe-4">@item.EntryFee.ToString("C")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
