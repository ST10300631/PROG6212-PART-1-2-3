<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDaySystem.Client</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDaySystem.Client.styles.css" asp-append-version="true" />
    <!-- Fixed: Completed the absolute CDN path for Bootstrap Icons to render correctly -->
    <link rel="stylesheet" href="https://jsdelivr.net" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">RaceDaySystem.Client</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Left-Aligned Navigation Items List Container -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        <!-- Context Session Extraction -->
                        @{
                            string? role = Context.Session.GetString("Role");
                        }

                        <!-- Organiser Context Links -->
                        @if (role == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Events" asp-action="Create">Create Event</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Result" asp-action="Create">Record Race Result</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Result" asp-action="Result">Manage All Results</a>
                            </li>
                        }

                        <!-- Participant Context Links -->
                        @if (role == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Events" asp-action="Index">View Race Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Registrations" asp-action="MyRegistrations">My Race Entries</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Result" asp-action="Result">My Race Results</a>
                            </li>
                        }
                    </ul>

                    <!-- Right-Aligned User Session Actions Block -->
                    <ul class="navbar-nav">
                        @if (Context.Session.GetInt32("Id") != null)
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="navbar-text text-dark">
                                    Hello, <strong>@Context.Session.GetString("Name")</strong> (@Context.Session.GetString("Role"))
                                </span>
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link text-dark py-0 border-0 align-baseline">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Account" asp-action="Index">Login</a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDaySystem.Client - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
