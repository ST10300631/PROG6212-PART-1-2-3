@{
    ViewData["Title"] = "Welcome to RaceDay";
}

<div class="container mt-5">

    <div class="p-5 mb-4 bg-primary text-white rounded shadow">
        <div class="container-fluid py-4">
            <h1 class="display-4 fw-bold">
                🎉🎉🎉 Welcome to RaceDay
            </h1>
            <p class="fs-5">
                South Africa's premier road running, walking, and cycling event
                management platform.
            </p>

            <p>
                RaceDay connects event organisers and participants through a modern
                event management system that simplifies registrations, event tracking,
                category management, and race results.
            </p>

            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">
                Register
            </a>
        </div>
    </div>

    <div class="row text-center mb-5">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h3> Events</h3>
                    <p>
                        Browse upcoming races, community runs, cycling events,
                        and charity walks across South Africa.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h3> Categories</h3>
                    <p>
                        Manage race categories, entry fees, participant groups,
                        and race classifications.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h3> Results</h3>
                    <p>
                        View race results, finishing positions, leaderboards,
                        and participant performance records.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h2>About RaceDay</h2>

            <p>
                RaceDay was developed to support the growing road running,
                walking, and cycling community in South Africa. The system allows
                event organisers to create and manage events while participants can
                register for races and track their results in one central location.
            </p>

            <p>
                Features include:
            </p>

            <ul>
                <li>Event Management</li>
                <li>Participant Registration</li>
                <li>Category Administration</li>
                <li>Live Race Results</li>
                <li>Performance Tracking</li>
                <li>Weather Integration</li>
            </ul>

            <div class="alert alert-info mt-3">
                <strong>Portfolio of Evidence (PoE)</strong><br />
                This application was developed as part of the PROG6212
                Portfolio of Evidence project and demonstrates modern
                ASP.NET Core MVC development practices.
            </div>
        </div>
    </div>

</div>